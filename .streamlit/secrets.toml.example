# Paste into Streamlit Cloud > App settings > Secrets (or .streamlit/secrets.toml locally).

# The only account that can see overall results. Choose your own strong password.
[admin]
login_id = "portal.admin"
password = "CHANGE-ME-to-a-strong-password"

# OPTIONAL: only add this block if you want a "Sign in with Google" button as well.
# [auth]
# redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"
# cookie_secret = "any-long-random-string"
# client_id = "xxxx.apps.googleusercontent.com"
# client_secret = "xxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
